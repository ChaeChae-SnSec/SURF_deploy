{
  "uid": "surf-main",
  "title": "SURF — AI DGA 탐지",
  "description": "DNS 경로와 확장 단독 경로를 함께 본다",
  "tags": [
    "surf"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 2,
  "editable": true,
  "refresh": "5s",
  "time": {
    "from": "now-15m",
    "to": "now"
  },
  "panels": [
    {
      "type": "stat",
      "title": "모델 판정 질의",
      "datasource": {
        "type": "prometheus",
        "uid": "surf-prom"
      },
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 0,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "text"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "text",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "auto",
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "surf-prom"
          },
          "expr": "sum(surf_dns_queries_total{result!=\"ignored\"})",
          "legendFormat": "총 질의",
          "refId": "A"
        }
      ],
      "description": "판별 모듈까지 도달한 질의. 캐시에서 응답한 것은 빠진다."
    },
