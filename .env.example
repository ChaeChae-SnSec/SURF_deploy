# 복사해서 .env 로 쓰세요.

# ---- 사용할 브랜치 ----
# 아직 main 에 병합 전이면 작업 브랜치를 지정합니다.
DNS_REF=main
WEB_REF=main
MODEL_REF=main

# ---- 모델 ----
# drift    : 공개된 DSN 2026 체크포인트 (현재 유일하게 확보된 가중치)
# surf-tld : SURF 의 TLD-aware 가중치. 확보되면 이 값으로 바꾸고 아티팩트를 교체합니다.
SURF_MODEL_VARIANT=drift

# CPU 추론 스레드. 컨테이너 2개가 각각 모델을 물고 있으므로
# (unbound + api) x TORCH_THREADS 가 코어 수를 넘지 않게 잡으세요.
TORCH_THREADS=2
GUNICORN_THREADS=8
DOH_THREADS=16

# ---- 업스트림 리졸버 ----
# dot   : DNS-over-TLS. 질의가 경유 구간에서 보이지 않는다.
# plain : 평문 53. TLS 를 가로채는 방화벽 뒤에서는 이쪽만 동작한다.
DNS_UPSTREAM_MODE=plain

# ---- API ----
# 웹 데모 페이지를 붙일 때는 그 오리진만 남기는 편이 안전합니다.
CORS_ORIGINS=*
RATE_LIMIT_PER_MIN=600

# ---- 모니터링 ----
GRAFANA_ADMIN_PASSWORD=
GRAFANA_ROOT_URL=https://dash.example.com
METRICS_RETENTION=45d

# ---- Cloudflare 터널 ----
# 대시보드에서 터널을 만들고 발급된 토큰을 넣습니다.
# 터널 공개 호스트명 설정(Cloudflare 대시보드에서):
#   dns.example.com   -> http://localhost:8053
#   api.example.com   -> http://localhost:5000
#   dash.example.com  -> http://localhost:3000
CLOUDFLARE_TUNNEL_TOKEN=
